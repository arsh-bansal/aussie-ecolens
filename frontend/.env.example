# Cognito and API config for the Aussie EcoLens frontend.
# Copy this file to `.env.local` and fill in real values from the
# CloudFormation outputs (see ../AUTH-SETUP.md).

# --- Cognito (aussie-ecolens-auth stack) ---
VITE_AWS_REGION=ap-southeast-2
VITE_COGNITO_USER_POOL_ID=ap-southeast-2_xxxxxxxxx
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# --- API + S3 (aussie-ecolens-infra stack) ---
VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.ap-southeast-2.amazonaws.com
VITE_S3_UPLOADS_BUCKET=aussie-ecolens-uploads-xxxxxxxxxxxx
