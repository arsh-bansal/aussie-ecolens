# Copy this file to `.env` and fill in real values.
# Never commit `.env`.

# ---------- AWS ----------
AWS_REGION=ap-southeast-2
AWS_ACCOUNT_ID=

# Names — keep consistent across infra and code
PROJECT_NAME=aussie-ecolens
S3_INGEST_BUCKET=aussie-ecolens-uploads
S3_THUMBNAIL_BUCKET=aussie-ecolens-thumbnails
S3_FRAMES_BUCKET=aussie-ecolens-frames
S3_MODELS_BUCKET=aussie-ecolens-models
DYNAMODB_FILES_TABLE=aussie-ecolens-files
SNS_TOPIC_PREFIX=aussie-ecolens-tag

# Cognito
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
COGNITO_IDENTITY_POOL_ID=
COGNITO_DOMAIN=

# Model versioning — change these to swap models without touching code
MEGADETECTOR_VERSION=v1
SPECIESNET_VERSION=v1
DETECTION_CONF_THRESHOLD=0.25
CLASSIFICATION_CONF_THRESHOLD=0.4
VIDEO_FPS=1

# ---------- Azure ----------
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=aussie-ecolens-rg
AZURE_LOCATION=australiaeast
AZURE_FUNCTION_APP_NAME=aussie-ecolens-api
COSMOS_ACCOUNT_NAME=aussie-ecolens-cosmos
COSMOS_ENDPOINT=
COSMOS_KEY=
COSMOS_DATABASE=aussie-ecolens
COSMOS_CONTAINER=files
AZURE_BLOB_ACCOUNT=aussieecolensquery
AZURE_BLOB_CONTAINER=ephemeral-queries

# ---------- Cross-cloud ----------
# How Azure verifies Cognito JWTs
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/REPLACE_USER_POOL_ID
COGNITO_JWKS_URL=https://cognito-idp.us-east-1.amazonaws.com/REPLACE_USER_POOL_ID/.well-known/jwks.json
COGNITO_AUDIENCE=REPLACE_APP_CLIENT_ID

# ---------- Query API deploy (used by lambdas/api_handlers/deploy.sh) ----------
QUERY_API_STACK_NAME=aussie-ecolens-query-api
TAGGER_LAMBDA_NAME=aussie-ecolens-query-tagger
SNS_TOPIC_ARN=arn:aws:sns:ap-southeast-2:ACCOUNT_ID:aussie-ecolens-tag-notifications

# ---------- Frontend ----------
NEXT_PUBLIC_AWS_REGION=ap-southeast-2
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_APP_CLIENT_ID=
NEXT_PUBLIC_AWS_API_BASE=
NEXT_PUBLIC_AZURE_API_BASE=
