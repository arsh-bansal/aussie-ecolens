# Copy to .env.production.local before npm run deploy:oci
# Values are baked into the static build — use production API URLs.

NEXT_PUBLIC_AWS_REGION=ap-southeast-2
NEXT_PUBLIC_COGNITO_USER_POOL_ID=ap-southeast-2_XXXXXXXXX
NEXT_PUBLIC_COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_AWS_API_BASE=https://xxxxxxxxxx.execute-api.ap-southeast-2.amazonaws.com
NEXT_PUBLIC_AZURE_API_BASE=https://xxxxxxxxxx.execute-api.ap-southeast-2.amazonaws.com
