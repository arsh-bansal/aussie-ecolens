# Copy to .env.local and fill in real values. Never commit .env.local.
# Live values are in HANDOFF.md / posted in the team chat by Adam (P1).

# Cognito — get from Adam (aussie-ecolens-auth stack outputs).
# Region is ap-southeast-2 (Sydney); the lib infers it from the pool ID,
# so NEXT_PUBLIC_AWS_REGION is optional but kept for clarity.
NEXT_PUBLIC_AWS_REGION=ap-southeast-2
NEXT_PUBLIC_COGNITO_USER_POOL_ID=ap-southeast-2_XXXXXXXXX
NEXT_PUBLIC_COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS API Gateway base URL (write path — uploads, tag edits, deletes, subscriptions).
# NOTE: the HTTP API uses the $default stage, so there is NO /prod (or any)
# path suffix — the base URL ends at ".amazonaws.com".
NEXT_PUBLIC_AWS_API_BASE=https://xxxxxxxxxx.execute-api.ap-southeast-2.amazonaws.com

# Query API base URL (reads + mutations: search, tags, delete, subscribe, list).
# Despite the name, this is the AWS API Gateway URL for lambdas/api_handlers
# (Flask on Lambda reading Azure Cosmos) — not an Azure Function App hostname.
NEXT_PUBLIC_AZURE_API_BASE=https://xxxxxxxxxx.execute-api.ap-southeast-2.amazonaws.com
