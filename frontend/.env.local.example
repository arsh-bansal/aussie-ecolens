# Copy to .env.local and fill in real values. Never commit .env.local.

# Cognito (get from Adam)
NEXT_PUBLIC_AWS_REGION=us-east-1
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
NEXT_PUBLIC_COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS API Gateway base URL (write path — uploads, tag edits, deletes, subscriptions)
NEXT_PUBLIC_AWS_API_BASE=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/prod

# Azure Function App base URL (read path — all search queries)
NEXT_PUBLIC_AZURE_API_BASE=https://aussie-ecolens-api.azurewebsites.net/api
